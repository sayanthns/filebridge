<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/canvas">

    <!-- ================= CONNECT SCREEN =================
         One clear primary action (Scan), with pasting as the subordinate
         path. Hidden entirely once connected so the list owns the screen. -->
    <ScrollView
        android:id="@+id/connectBar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <ImageView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginTop="28dp"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="File Bridge" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="File Bridge"
                android:textColor="@color/ink"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Move files between your Mac and this phone over wifi"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <!-- Primary action: 56dp tall, well above the 48dp minimum -->
            <Button
                android:id="@+id/scanBtn"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:backgroundTint="@color/brand"
                android:text="Scan QR from Mac"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="Open File Bridge on the Mac and press Start Sharing"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="26dp"
                android:background="@color/line" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Or paste the link"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Visible label above, not a placeholder-only field -->
            <EditText
                android:id="@+id/urlInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@color/surface"
                android:hint="http://10.0.0.5:8001/?t=key"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:paddingHorizontal="12dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/muted"
                android:textSize="14sp" />

            <Button
                android:id="@+id/connectBtn"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:text="Connect"
                android:textAllCaps="false"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/connectError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="#D92D20"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <!-- ================= BROWSER SCREEN ================= -->
    <LinearLayout
        android:id="@+id/browser"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Top app bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/brand"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="File Bridge"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#DCEBFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Breadcrumb -->
        <TextView
            android:id="@+id/pathText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:paddingHorizontal="16dp"
            android:paddingVertical="9dp"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/fileList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:divider="@color/line"
                android:dividerHeight="1dp" />

            <!-- Empty state: says what to do, not just "nothing here" -->
            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nothing here yet"
                    android:textColor="@color/ink"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="On the Mac, drop files into the To Phone folder and press Reload."
                    android:textColor="@color/muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/spinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@color/brand"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Bottom action bar -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:orientation="horizontal"
            android:padding="12dp">

            <!-- "Send to Mac" wrapped and clipped at this width. Single line,
                 slightly smaller text, and no wrapping allowed. -->
            <Button
                android:id="@+id/uploadBtn"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1.2"
                android:backgroundTint="@color/brand"
                android:maxLines="1"
                android:paddingHorizontal="6dp"
                android:text="Send"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/refreshBtn"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:paddingHorizontal="6dp"
                android:text="Reload"
                android:textAllCaps="false"
                android:textSize="14sp" />

            <!-- Separated from the two normal actions: leaving is destructive
                 in the sense that it drops the saved connection. -->
            <Button
                android:id="@+id/disconnectBtn"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:maxLines="1"
                android:text="Exit"
                android:textAllCaps="false"
                android:textColor="#D92D20"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
