<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:orientation="vertical">

    <!-- Screens stack here; the bottom bar below never moves between states. -->
    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ============ CONNECT ============
             One primary action (Scan); pasting is deliberately subordinate. -->
        <ScrollView
            android:id="@+id/connectBar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginTop="24dp"
                    android:contentDescription="@string/app_name"
                    android:src="@mipmap/ic_launcher" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/app_name"
                    android:textColor="@color/ink"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/connect_tagline"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/scanBtn"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="30dp"
                    android:backgroundTint="@color/brand"
                    android:text="@string/scan_qr"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="@string/scan_help"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />

                <!-- Surfaced here rather than buried in settings: a blocked
                     camera is the likeliest reason Scan seems to do nothing. -->
                <TextView
                    android:id="@+id/permBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="#FFF4E5"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:padding="12dp"
                    android:text="@string/perm_banner"
                    android:textColor="#8A5300"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="24dp"
                    android:background="@color/line" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:labelFor="@+id/urlInput"
                    android:text="@string/paste_link"
                    android:textColor="@color/ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/urlInput"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@color/surface"
                    android:hint="@string/link_hint"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:paddingHorizontal="12dp"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/muted"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/connectBtn"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/connect"
                    android:textAllCaps="false"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/connectError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:textColor="@color/danger"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>

        <!-- ============ BROWSE ============ -->
        <LinearLayout
            android:id="@+id/browser"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/brand"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#DCEBFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/pathText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface"
                android:paddingHorizontal="16dp"
                android:paddingVertical="9dp"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/line" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <ListView
                    android:id="@+id/fileList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@color/line"
                    android:dividerHeight="1dp" />

                <LinearLayout
                    android:id="@+id/emptyState"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="32dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:alpha="0.35"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_folder" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/empty_title"
                        android:textColor="@color/ink"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/empty_body"
                        android:textColor="@color/muted"
                        android:textSize="14sp" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/spinner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/brand"
                    android:visibility="gone" />
            </FrameLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/line" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface"
                android:orientation="horizontal"
                android:padding="12dp">

                <Button
                    android:id="@+id/uploadBtn"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/brand"
                    android:maxLines="1"
                    android:text="@string/send"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/refreshBtn"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:text="@string/reload"
                    android:textAllCaps="false"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ SETTINGS ============ -->
        <ScrollView
            android:id="@+id/settings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/brand"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tab_settings"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView style="@style/SectionHeader" android:text="@string/sec_permissions" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingBottom="10dp"
                    android:text="@string/perm_intro"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <LinearLayout android:id="@+id/rowNotif" style="@style/SettingRow">
                    <ImageView android:id="@+id/iconNotif" style="@style/RowIcon"
                        android:src="@drawable/ic_download" android:contentDescription="@null" />
                    <LinearLayout style="@style/RowText">
                        <TextView style="@style/RowTitle" android:text="@string/perm_notif" />
                        <TextView android:id="@+id/subNotif" style="@style/RowSub" />
                    </LinearLayout>
                    <TextView android:id="@+id/actNotif" style="@style/RowAction" />
                </LinearLayout>

                <LinearLayout android:id="@+id/rowCamera" style="@style/SettingRow">
                    <ImageView android:id="@+id/iconCamera" style="@style/RowIcon"
                        android:src="@drawable/ic_files" android:contentDescription="@null" />
                    <LinearLayout style="@style/RowText">
                        <TextView style="@style/RowTitle" android:text="@string/perm_camera" />
                        <TextView android:id="@+id/subCamera" style="@style/RowSub" />
                    </LinearLayout>
                    <TextView android:id="@+id/actCamera" style="@style/RowAction" />
                </LinearLayout>

                <LinearLayout android:id="@+id/rowBattery" style="@style/SettingRow">
                    <ImageView android:id="@+id/iconBattery" style="@style/RowIcon"
                        android:src="@drawable/ic_shield_ok" android:contentDescription="@null" />
                    <LinearLayout style="@style/RowText">
                        <TextView style="@style/RowTitle" android:text="@string/perm_battery" />
                        <TextView android:id="@+id/subBattery" style="@style/RowSub" />
                    </LinearLayout>
                    <TextView android:id="@+id/actBattery" style="@style/RowAction" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp"
                    android:text="@string/perm_battery_why"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />

                <LinearLayout android:id="@+id/rowAppInfo" style="@style/SettingRow">
                    <ImageView style="@style/RowIcon" android:src="@drawable/ic_settings"
                        android:contentDescription="@null" />
                    <LinearLayout style="@style/RowText">
                        <TextView style="@style/RowTitle" android:text="@string/open_app_settings" />
                        <TextView style="@style/RowSub" android:text="@string/open_app_settings_sub" />
                    </LinearLayout>
                    <ImageView style="@style/RowChevron" android:src="@drawable/ic_chevron"
                        android:contentDescription="@null" />
                </LinearLayout>

                <TextView style="@style/SectionHeader" android:text="@string/sec_connection" />

                <LinearLayout style="@style/SettingRow">
                    <ImageView style="@style/RowIcon" android:src="@drawable/ic_link"
                        android:contentDescription="@null" />
                    <LinearLayout style="@style/RowText">
                        <TextView style="@style/RowTitle" android:text="@string/server" />
                        <TextView android:id="@+id/subServer" style="@style/RowSub" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout style="@style/SettingRow">
                    <ImageView style="@style/RowIcon" android:src="@drawable/ic_download"
                        android:contentDescription="@null" />
                    <LinearLayout style="@style/RowText">
                        <TextView style="@style/RowTitle" android:text="@string/downloads_go_to" />
                        <TextView style="@style/RowSub" android:text="@string/downloads_path" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:id="@+id/rowDisconnect" style="@style/SettingRow">
                    <ImageView style="@style/RowIcon" android:src="@drawable/ic_warning"
                        android:contentDescription="@null" />
                    <LinearLayout style="@style/RowText">
                        <TextView style="@style/RowTitle" android:text="@string/disconnect"
                            android:textColor="@color/danger" />
                        <TextView style="@style/RowSub" android:text="@string/disconnect_sub" />
                    </LinearLayout>
                </LinearLayout>

                <TextView style="@style/SectionHeader" android:text="@string/sec_about" />

                <LinearLayout style="@style/SettingRow">
                    <ImageView style="@style/RowIcon" android:src="@mipmap/ic_launcher"
                        android:contentDescription="@null" />
                    <LinearLayout style="@style/RowText">
                        <TextView style="@style/RowTitle" android:text="@string/app_name" />
                        <TextView android:id="@+id/subVersion" style="@style/RowSub" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:id="@+id/rowSource" style="@style/SettingRow">
                    <ImageView style="@style/RowIcon" android:src="@drawable/ic_link"
                        android:contentDescription="@null" />
                    <LinearLayout style="@style/RowText">
                        <TextView style="@style/RowTitle" android:text="@string/source_code" />
                        <TextView style="@style/RowSub" android:text="@string/source_sub" />
                    </LinearLayout>
                    <ImageView style="@style/RowChevron" android:src="@drawable/ic_chevron"
                        android:contentDescription="@null" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="20dp"
                    android:text="@string/license_line"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- ============ BOTTOM NAV ============
         Two destinations, icon AND label on each. Reachable before connecting,
         so permissions can be fixed first — a blocked camera is exactly why
         Scan would appear to do nothing. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/surface"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tabFiles"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/tabFilesIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_files" />

            <TextView
                android:id="@+id/tabFilesLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/tab_files"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/tabSettingsIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_settings" />

            <TextView
                android:id="@+id/tabSettingsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/tab_settings"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
